{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    /* vitest/globals so describe/it/expect need no import in every test file. Node is
       here for the tests that read files off disk, not for the app, which ships to a
       browser and has no process or fs at runtime. */
    "types": [
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest",
      "node"
    ],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strict": true,

    /* Matches the alias in vite.config.ts. Resolved relative to this file, since
       baseUrl is deprecated as of TypeScript 6. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
