# Leave unset for local development: the Vite dev proxy forwards every API prefix to
# http://localhost:8000, so requests stay same-origin and CORS never comes into it. The
# list of prefixes lives in vite.config.ts and is checked against the backend's routers
# by src/lib/proxy.test.ts, because a missing one fails as an empty screen rather than an
# error. That list includes /billing, /admin, /capabilities, and /meta alongside the
# ledger routes.
#
# In production this must be the deployed API origin, with no trailing slash.
# VITE_API_BASE_URL=https://glaux-ledger-api.up.railway.app

# Billing. Bank details are build-time copy for the Settings payment card and landing
# page; payment proof itself is uploaded through the API. Leave the bank details unset
# and the card falls back to "email us", which is better than shipping a placeholder
# account number.
# VITE_PRICE_MONTHLY=LKR 1,500
# VITE_SUPPORT_EMAIL=hello@glauxledger.lk
# VITE_PAY_BANK=Commercial Bank
# VITE_PAY_ACCOUNT_NAME=Glaux Software
# VITE_PAY_ACCOUNT_NUMBER=8001234567
