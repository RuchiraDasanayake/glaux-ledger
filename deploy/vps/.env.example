# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Public hostname for the API (A record → VPS IP). Caddy uses this for HTTPS.
API_DOMAIN=api.example.com

# Frontend origin(s), no trailing slash. Comma-separate if you have a custom domain too.
CORS_ORIGINS=https://glaux-ledger.pages.dev,https://ledger.example.com

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Postgres owner (migrations + admin review) and app role (RLS-enforced API).
# Use URL-safe secrets (avoid + / = in passwords — they break DATABASE_URL):
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
GLAUX_APP_PASSWORD=

ADMIN_JWT_EXPIRE_MINUTES=480
PARSER_PROVIDER=stub
# OPENAI_API_KEY=
# AI_CALLS_PER_MONTH=500
# SENTRY_DSN=
