# Runtime connection. Deliberately the unprivileged role: Postgres ignores row-level
# security for superusers, so connecting as the owner would disable the RLS safety net.
DATABASE_URL=postgresql+psycopg://glaux_app:glaux_dev_password@localhost:5432/glaux_ledger

# Alembic needs DDL rights, which the runtime role does not have. Omit this on hosts
# that hand you a single owning role (Railway, Render, Neon); it falls back to
# DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql+psycopg://glaux:glaux_dev_password@localhost:5432/glaux_ledger
# Optional distinct privileged connection for cross-tenant platform review. Defaults to
# MIGRATION_DATABASE_URL when omitted.
# ADMIN_DATABASE_URL=postgresql+psycopg://glaux:...@localhost:5432/glaux_ledger

# Required. There is no default, and startup fails without it. Must be >= 32 bytes
# (RFC 7518 s3.2 for HS256). Generate your own; do not copy the line below:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=20160
# Platform reviewer sessions are deliberately shorter than shop-device sessions.
ADMIN_JWT_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# stub  -> offline rule-based parsing, no API key needed
# openai -> real speech-to-text + vision OCR + LLM extraction. Setting this without
#           OPENAI_API_KEY fails at startup rather than at the first upload.
PARSER_PROVIDER=stub
# OPENAI_API_KEY=sk-...

# Voice and photo entries allowed per shop per calendar month. These are the only two
# routes that cost money at a third party.
# AI_CALLS_PER_MONTH=500

# Bank-slip evidence and per-shop submission limits.
# PAYMENT_EVIDENCE_MAX_BYTES=10485760
# PAYMENT_SUBMISSION_RATE_LIMIT=5
# PAYMENT_SUBMISSION_RATE_WINDOW_SECONDS=3600
